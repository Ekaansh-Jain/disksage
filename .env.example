# disksage reads its settings from ~/.config/disksage/.env, which
# `disksage setup` writes for you. To set it up by hand instead, copy this file
# there, fill in one provider, and run `chmod 600 ~/.config/disksage/.env`.
# Variables exported in your shell work too, and win over the file.
# disksage never reads a .env file from the folder you run it in.
#
# The tool works with NONE of these set: it uses its built-in list.
# A cloud provider is used only when DISKSAGE_PROVIDER names it, never just
# because its key is set.

# --- Groq (free tier, fast cloud) ---
# DISKSAGE_PROVIDER=groq
GROQ_API_KEY=
# DISKSAGE_GROQ_MODEL=openai/gpt-oss-20b

# --- Google Gemini (free tier) ---
# DISKSAGE_PROVIDER=gemini
GEMINI_API_KEY=
# DISKSAGE_GEMINI_MODEL=gemini-flash-latest

# --- Local (private, offline) — any OpenAI-compatible server ---
# Auto-detected on the usual ports (Ollama :11434, LM Studio :1234,
# llama.cpp/LocalAI :8080, Jan :1337, …). Or point at one explicitly:
# DISKSAGE_PROVIDER=local
# DISKSAGE_LOCAL_BASE_URL=http://localhost:11434/v1
# DISKSAGE_LOCAL_MODEL=llama3.1

# --- No AI: nothing is sent anywhere, not even to a local server ---
# DISKSAGE_AI=off
