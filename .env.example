# Copy this file to `.env` and fill in whichever provider you want to use.
# The tool works with NONE of these set — it just uses the knowledge base.
# Priority when auto-detecting: local (LM Studio) -> groq -> gemini.

# --- Groq (free tier, fast cloud) ---
GROQ_API_KEY=
# DISKSAGE_GROQ_MODEL=openai/gpt-oss-20b

# --- Google Gemini (free tier) ---
GEMINI_API_KEY=
# DISKSAGE_GEMINI_MODEL=gemini-flash-latest

# --- Local (private, offline) — any OpenAI-compatible server ---
# Auto-detected on the usual ports (Ollama :11434, LM Studio :1234,
# llama.cpp/LocalAI :8080, Jan :1337, …). Or point at one explicitly:
# DISKSAGE_LOCAL_BASE_URL=http://localhost:11434/v1
# DISKSAGE_LOCAL_MODEL=llama3.1

# Force a specific provider (optional): local | groq | gemini
# DISKSAGE_PROVIDER=local
